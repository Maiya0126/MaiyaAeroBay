<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- 民用航空：解锁民用穿梭机 -->
  <ResearchProjectDef>
    <defName>MaiyaAeroBay_CivilianAviation</defName>
    <label>民用航空</label>
    <description>解锁建造民用穿梭机的能力。不需要稀有的穿梭机引擎，用化合燃料驱动。</description>
    <baseCost>1000</baseCost>
    <prerequisites>
      <li>Electricity</li>
    </prerequisites>
    <researchViewX>4.5</researchViewX>
    <researchViewY>7.0</researchViewY>
    <techLevel>Industrial</techLevel>
  </ResearchProjectDef>

  <!-- 穿梭机改造入门：解锁基础套件 -->
  <ResearchProjectDef>
    <defName>MaiyaAeroBay_BasicExpansion</defName>
    <label>穿梭机改造入门</label>
    <description>解锁穿梭机基础改装能力：空间套件Lv.1-2、舒适套件I、动力套件I、简易护盾套件、双联机枪套件。</description>
    <baseCost>800</baseCost>
    <prerequisites>
      <li>MaiyaAeroBay_CivilianAviation</li>
    </prerequisites>
    <researchViewX>5.5</researchViewX>
    <researchViewY>7.0</researchViewY>
    <techLevel>Industrial</techLevel>
  </ResearchProjectDef>

  <!-- 穿梭机改造进阶：解锁中级套件 -->
  <ResearchProjectDef>
    <defName>MaiyaAeroBay_AdvancedExpansion</defName>
    <label>穿梭机改造进阶</label>
    <description>解锁穿梭机中级改装能力：空间套件Lv.3-4、舒适套件II、动力套件II、能量护盾套件、机炮与火箭巢套件。</description>
    <baseCost>1200</baseCost>
    <prerequisites>
      <li>MaiyaAeroBay_BasicExpansion</li>
    </prerequisites>
    <researchViewX>6.5</researchViewX>
    <researchViewY>7.0</researchViewY>
    <techLevel>Industrial</techLevel>
  </ResearchProjectDef>

  <!-- 穿梭机改造精通：解锁高级套件 -->
  <ResearchProjectDef>
    <defName>MaiyaAeroBay_UltimateExpansion</defName>
    <label>穿梭机改造精通</label>
    <description>解锁穿梭机高级改装能力：空间套件Lv.5、舒适套件III、动力套件III、强化护盾套件、激光炮套件。</description>
    <baseCost>2000</baseCost>
    <prerequisites>
      <li>MaiyaAeroBay_AdvancedExpansion</li>
    </prerequisites>
    <researchViewX>7.5</researchViewX>
    <researchViewY>7.0</researchViewY>
    <techLevel>Spacer</techLevel>
  </ResearchProjectDef>

</Defs>
