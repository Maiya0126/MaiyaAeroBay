<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ThingDef ParentName="ResourceBase" Name="MaiyaAeroBayRideHailingKitBase" Abstract="true">
    <thingClass>ThingWithComps</thingClass>
    <category>Item</category>
    <resourceReadoutPriority>Middle</resourceReadoutPriority>
    <useHitPoints>true</useHitPoints>
    <selectable>true</selectable>
    <altitudeLayer>Item</altitudeLayer>
    <stackLimit>1</stackLimit>
    <statBases>
      <MaxHitPoints>100</MaxHitPoints>
      <Flammability>0.3</Flammability>
      <DeteriorationRate>0</DeteriorationRate>
      <Mass>4</Mass>
    </statBases>
    <thingCategories>
      <li>ItemsMisc</li>
    </thingCategories>
    <alwaysHaulable>true</alwaysHaulable>
    <drawGUIOverlay>true</drawGUIOverlay>
    <tradeability>All</tradeability>
    <comps>
      <li Class="CompProperties_Forbiddable"/>
      <li Class="CompProperties_Usable">
        <useJob>UseArtifact</useJob>
        <useLabel>Install R-ber kit on shuttle</useLabel>
        <useDuration>120</useDuration>
      </li>
      <li Class="MaiyaAeroBay.CompProperties_TargetableSingleShuttle"/>
      <li Class="MaiyaAeroBay.CompProperties_TargetEffectInstallAeroBayKit"/>
    </comps>
  </ThingDef>

  <ThingDef ParentName="MaiyaAeroBayRideHailingKitBase">
    <defName>MaiyaAeroBay_RideHailingKit</defName>
    <label>R-ber Kit</label>
    <description>Install a ride-hailing system on your shuttle and unlock R-ber mode! Earn silver by carrying passengers or cargo between friendly settlements. Complete orders to build up your star rating and unlock higher-paying missions.\n\nEach shuttle can only have one R-ber kit installed. Cannot be replaced.</description>
    <graphicData>
      <texPath>Things/Item/Resource/ComponentIndustrial</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>
    <statBases>
      <MarketValue>120</MarketValue>
      <Mass>2</Mass>
    </statBases>
    <comps>
      <li Class="MaiyaAeroBay.CompProperties_AeroBayKit">
        <kitType>RideHailing</kitType>
        <fareBasePrice>50</fareBasePrice>
        <baseOrderRange>20</baseOrderRange>
        <orderIntervalDays>2</orderIntervalDays>
      </li>
    </comps>
  </ThingDef>

</Defs>
