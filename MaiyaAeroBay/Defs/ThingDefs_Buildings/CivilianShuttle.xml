<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- 民用穿梭机 - 前期可建造，不需要穿梭机引擎 -->
  <ThingDef ParentName="BuildingBase">
    <defName>MaiyaAeroBay_CivilianShuttle</defName>
    <label>民用穿梭机</label>
    <description>一位麦姓大叔实在看不下去帝国那拙劣的穿梭机工艺——斥巨资打造的铁疙瘩，内部空空如也，连张床都不放。于是他愤而另起炉灶，造出了这架轻巧实用的民用穿梭机。不需要稀有的穿梭机引擎，研究电力后即可建造。载重200kg，最大航程约30格。\n\n可使用五类套件进行改装：空间套件（最高Lv.2）、武器套件、护盾套件、动力套件、舒适套件。每类套件限装一个，建议先规划再安装。</description>
    <altitudeLayer>Building</altitudeLayer>
    <blockWind>true</blockWind>
    <building>
      <claimable>false</claimable>
      <destroySound>BuildingDestroyed_Metal_Big</destroySound>
      <paintable>true</paintable>
    </building>
    <canOverlapZones>true</canOverlapZones>
    <category>Building</category>
    <comps>
      <li Class="CompProperties_Shuttle">
        <shipDef>Ship_MaiyaCivilianShuttle</shipDef>
      </li>
      <li Class="CompProperties_Launchable">
        <fuelPerTile>5</fuelPerTile>
        <minFuelCost>30</minFuelCost>
        <skyfallerLeaving>PassengerShuttleLeaving</skyfallerLeaving>
        <worldObjectDef>MaiyaCivilianShuttle</worldObjectDef>
        <cooldownTicks>3750</cooldownTicks>
        <fixedLaunchDistanceMax>30</fixedLaunchDistanceMax>
        <cooldownEndedMessage>{0} ready to launch again.</cooldownEndedMessage>
      </li>
      <li Class="CompProperties_Transporter">
        <massCapacity>200</massCapacity>
        <max1PerGroup>true</max1PerGroup>
        <canChangeAssignedThingsAfterStarting>true</canChangeAssignedThingsAfterStarting>
        <pawnLoadedSound>Shuttle_PawnLoaded</pawnLoadedSound>
        <pawnExitSound>Shuttle_PawnExit</pawnExitSound>
        <showMassInInspectString>true</showMassInInspectString>
      </li>
      <li Class="CompProperties_Refuelable">
        <fuelCapacity>200</fuelCapacity>
        <targetFuelLevelConfigurable>true</targetFuelLevelConfigurable>
        <initialConfigurableTargetFuelLevel>200</initialConfigurableTargetFuelLevel>
        <fuelFilter>
          <thingDefs>
            <li>Chemfuel</li>
          </thingDefs>
        </fuelFilter>
        <fuelLabel>化合燃料</fuelLabel>
        <fuelGizmoLabel>化合燃料</fuelGizmoLabel>
        <consumeFuelOnlyWhenUsed>true</consumeFuelOnlyWhenUsed>
        <autoRefuelPercent>1</autoRefuelPercent>
        <showFuelGizmo>true</showFuelGizmo>
        <drawOutOfFuelOverlay>false</drawOutOfFuelOverlay>
        <showAllowAutoRefuelToggle>true</showAllowAutoRefuelToggle>
        <canEjectFuel>true</canEjectFuel>
      </li>
      <li Class="CompProperties_AmbientSound">
        <sound>ShuttleIdle_Ambience</sound>
      </li>
      <li Class="MaiyaAeroBay.CompProperties_ShuttleKitInstaller"/>
    </comps>
    <constructionSkillPrerequisite>4</constructionSkillPrerequisite>
    <costList>
      <Steel>180</Steel>
      <ComponentIndustrial>3</ComponentIndustrial>
    </costList>
    <defaultPlacingRot>East</defaultPlacingRot>
    <designationCategory>Odyssey</designationCategory>
    <drawerType>RealtimeOnly</drawerType>
    <drawHighlight>true</drawHighlight>
    <fillPercent>0.5</fillPercent>
    <filthLeaving>Filth_RubbleBuilding</filthLeaving>
    <graphicData>
      <graphicClass>Graphic_Multi</graphicClass>
      <texPath>Things/Building/PassengerShuttle/PassengerShuttle</texPath>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>(2,3)</drawSize>
      <color>(140,140,130)</color>
      <shadowData>
        <volume>(1.2, 0.8, 2.5)</volume>
        <offset>(-0.1, 0, 0)</offset>
      </shadowData>
    </graphicData>
    <hasInteractionCell>true</hasInteractionCell>
    <highlightColor>(0.56, 0.62, 0.9)</highlightColor>
    <inspectorTabs>
      <li>ITab_ContentsTransporter</li>
    </inspectorTabs>
    <interactionCellOffset>(1, 0, 0)</interactionCellOffset>
    <killedLeavings>
      <Steel>30</Steel>
      <ChunkSlagSteel>2</ChunkSlagSteel>
      <ComponentIndustrial>1</ComponentIndustrial>
    </killedLeavings>
    <leaveResourcesWhenKilled>true</leaveResourcesWhenKilled>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <placeWorkers>
      <li>PlaceWorker_NotUnderRoof</li>
    </placeWorkers>
    <preventDroppingThingsOn>true</preventDroppingThingsOn>
    <preventSkyfallersLandingOn>true</preventSkyfallersLandingOn>
    <repairEffect>ConstructMetal</repairEffect>
    <researchPrerequisites>
      <li>MaiyaAeroBay_CivilianAviation</li>
    </researchPrerequisites>
    <rotatable>true</rotatable>
    <selectable>true</selectable>
    <size>(2,3)</size>
    <soundImpactDefault>BulletImpact_Metal</soundImpactDefault>
    <statBases>
      <SellPriceFactor>0.7</SellPriceFactor>
      <MaxHitPoints>300</MaxHitPoints>
      <Flammability>0.5</Flammability>
      <WorkToBuild>12000</WorkToBuild>
      <Mass>75</Mass>
      <Comfort>0.5</Comfort>
    </statBases>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <thingClass>Building_PassengerShuttle</thingClass>
    <tickerType>Normal</tickerType>
    <uiIconScale>0.8</uiIconScale>
    <uiOrder>2550</uiOrder>
  </ThingDef>

  <!-- 民用穿梭机世界对象 -->
  <WorldObjectDef ParentName="ShuttleWorldObjectBase">
    <defName>MaiyaCivilianShuttle</defName>
    <label>民用穿梭机</label>
    <description>一架用化合燃料驱动的民用穿梭机。</description>
    <expandingIconTexture>World/WorldObjects/Expanding/PassengerShuttle</expandingIconTexture>
  </WorldObjectDef>

  <!-- 民用穿梭机飞船定义 -->
  <TransportShipDef>
    <defName>Ship_MaiyaCivilianShuttle</defName>
    <label>民用穿梭机</label>
    <arrivingSkyfaller>PassengerShuttleIncoming</arrivingSkyfaller>
    <leavingSkyfaller>PassengerShuttleLeaving</leavingSkyfaller>
    <playerShuttle>true</playerShuttle>
    <shipThing>MaiyaAeroBay_CivilianShuttle</shipThing>
    <worldObject>MaiyaCivilianShuttle</worldObject>
  </TransportShipDef>

</Defs>
